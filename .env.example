# The Make webhook that receives one lead per completed survey and appends a row
# to the "74 - StopRent" worksheet.
#
# Server-only: it is read exclusively by src/app/api/lead/route.ts and is never
# bundled into the browser. Do not prefix it with NEXT_PUBLIC_, and do not commit
# the real value — set it in the Vercel project's environment variables
# (Production, Preview and Development) and copy it into a local .env.local for
# development.
MAKE_WEBHOOK_URL=
